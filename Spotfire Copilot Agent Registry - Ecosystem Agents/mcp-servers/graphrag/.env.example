# GraphRAG MCP server — sample environment
# Copy to .env and fill in real values. See the Deployment Guide in this folder.

MCP_IMAGE_REF=copilotoci.azurecr.io/spotfirecopilot/mcp-graphrag:<image-tag>
HOST=0.0.0.0
PORT=8060
TRANSPORT=streamable-http

# --- Vector store (Milvus / Zilliz) ---
MILVUS_URI=https://<zilliz-endpoint>
MILVUS_TOKEN=<token>
MILVUS_COLLECTION=copilot_docs
# MILVUS_DB=default

# --- Query embeddings (MUST match the model used to load the corpus) ---
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=<api-key>
EMBEDDING_DIMENSION=1536
# Azure OpenAI only:
# EMBEDDING_API_VERSION=2024-02-01

# --- Knowledge graph (Neo4j) — optional; enables graph/lifecycle/DDR tools ---
# Leave NEO4J_URI empty to run documentation-only.
NEO4J_URI=neo4j+s://<neo4j-host>:7687
NEO4J_USERNAME=<username>
NEO4J_PASSWORD=<password>
NEO4J_DATABASE=neo4j

# MCP authentication settings
MCP_AUTH_ENABLED=true
MCP_AUTH_ISSUER_URL=https://auth.example.com
MCP_AUTH_RESOURCE_SERVER_URL=https://mcp.example.com
# Comma-separated required scopes (for JWT/JWKS mode)
MCP_AUTH_REQUIRED_SCOPES=
# Optional JWKS URL. If set, JWT/JWKS validation is used.
MCP_AUTH_JWKS_URL=
# Optional expected JWT audience (aud)
MCP_AUTH_AUDIENCE=
# Comma-separated static bearer tokens.
# If MCP_AUTH_JWKS_URL is empty, static MCP_AUTH_TOKENS validation is used.
# CHANGE this to your own secret token before deploying.
MCP_AUTH_TOKENS=<change-me>
